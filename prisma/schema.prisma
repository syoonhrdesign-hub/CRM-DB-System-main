// 교육 전문기업용 고객사(기업·기관) CRM 데이터 모델
//
// PostgreSQL 을 쓰되 DB 고유 기능(enum, array 등)은 사용하지 않고
// 문자열 + 애플리케이션 레벨 상수(src/lib/constants.ts)로 관리한다.
// 선택지를 늘리거나 이름을 바꿀 때 마이그레이션이 필요 없게 하기 위해서다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 사용자 — 이 CRM 을 쓰는 우리 회사 직원
///
/// 비밀번호는 scrypt 해시로만 저장한다(src/lib/auth.ts). 평문은 어디에도 남기지 않는다.
model User {
  id String @id @default(cuid())

  email String @unique
  name  String

  /// scrypt 해시. 형식은 "salt:hash" (auth.ts 참고)
  passwordHash String

  /// admin — 사용자 관리까지 가능 / member — 일반 사용
  role String @default("member")

  /// 퇴사자는 지우지 않고 비활성으로 둔다. 그가 남긴 활동 기록을 보존하기 위해서다.
  isActive Boolean @default(true)

  /// 다음 로그인 때 비밀번호를 바꾸게 한다 (관리자가 초기화해 준 직후)
  mustChangePassword Boolean @default(false)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// 고객사 — 교육을 의뢰하는 기업 / 공공기관 / 대학 / 병원 등
model Organization {
  id String @id @default(cuid())

  name      String // 기관명 (예: 한국전력공사)
  shortName String? // 약칭 (예: 한전)
  bizRegNo  String? @unique // 사업자등록번호 (000-00-00000)

  orgType       String  @default("기업") // 기업 / 공공기관 / 지자체 / 대학 / 병원 / 비영리 / 기타
  industry      String? // 업종 (제조, 금융, IT, 유통 ...)
  sizeTier      String? // 대기업 / 중견기업 / 중소기업 / 스타트업
  employeeCount Int? // 임직원 수 — 교육 규모 산정 기준

  status String @default("잠재고객") // 잠재고객 / 거래중 / 휴면 / 종료

  phone   String?
  website String?
  address String?

  /// 이 고객사를 맡은 우리 쪽 컨택 담당자
  ownerName String?

  /* ---------------------------------------------------------------------- */
  /*  고객사 쪽 창구 부서                                                     */
  /*  담당자(Contact)는 사람이라 바뀌지만 부서는 대체로 유지된다.              */
  /*  담당자가 퇴사해도 "어느 부서와 일했는지"는 남아 있어야 재접촉이 쉽다.     */
  /* ---------------------------------------------------------------------- */

  /// 교육을 담당하는 부서 (예: 인재개발원, 인사팀 교육파트)
  clientDepartment String?
  /// 그 부서가 맡은 업무 범위 (예: 전사 교육 기획·운영, 승진자 과정 주관)
  departmentRole   String?

  memo String?

  /* ---------------------------------------------------------------------- */
  /*  최초 접촉                                                              */
  /* ---------------------------------------------------------------------- */

  /// 이 고객사를 처음 알게 된 경로 (전시회 / 세미나 / 소개 / 인바운드 문의 ...)
  acquisitionChannel String?
  firstContactAt     DateTime?
  /// 소개로 들어왔다면 소개해 준 사람·기관
  referredBy         String?

  /* ---------------------------------------------------------------------- */
  /*  등급 평가 — 5개 축을 1~5점으로 매기고 가중 평균으로 S~D 등급을 낸다.      */
  /*  계산 로직과 가중치는 src/lib/grade.ts 한 곳에만 있다.                    */
  /* ---------------------------------------------------------------------- */

  /// 실제 구매 빈도
  scorePurchase  Int?
  /// 신뢰도 · 대외 상징성 (레퍼런스로 쓸 수 있는가)
  scoreTrust     Int?
  /// 재교육 가능 여부 (같은 과정을 다시 열 수 있는가)
  scoreRetrain   Int?
  /// 반복 교육 가능 여부 (정기 과정으로 자리잡을 수 있는가)
  scoreRecurring Int?
  /// 솔루션 제안 가능 여부 (단발 과정을 넘어 체계 구축을 제안할 수 있는가)
  scoreSolution  Int?

  /// 계산된 등급을 무시하고 직접 지정할 때 사용 (S / A / B / C / D)
  gradeOverride String?
  gradeMemo     String?
  gradedAt      DateTime?

  /* ---------------------------------------------------------------------- */
  /*  정례 접촉 관리                                                          */
  /* ---------------------------------------------------------------------- */

  /// 접촉 주기(주). 비워 두면 등급별 기본 주기를 따른다.
  contactCycleWeeks Int?

  profile       AccountProfile?
  research      CompanyResearch?
  contacts      Contact[]
  trainings     Training[]
  deals         Deal[]
  activities    Activity[]
  distributions CodeDistribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([orgType])
}

/// 진단 코드 배부 — 교육생이 스스로 자기 코드를 찾아가게 하는 공개 페이지 하나.
///
/// 교육생 수백 명에게 알림톡을 일일이 보내는 대신, 링크 하나를 고객사에 전달하면
/// 각자 이름을 검색해 자기 코드를 확인한다.
///
/// 공개 페이지라 로그인이 없다. 그래서 두 가지로 보호한다.
///  1. 주소(slug)를 길고 무작위하게 만들어 링크를 아는 사람만 들어오게 한다
///  2. 이름을 정확히 맞춰야만 한 건이 나온다. 목록을 훑을 수는 없다
model CodeDistribution {
  id String @id @default(cuid())

  /// 공개 주소에 쓰는 무작위 문자열 (/code/<slug>)
  slug String @unique

  /* 안내문 ---------------------------------------------------------------- */

  /// 제목 위 한 줄 (예: 팀원 간 행동유형과 강점을 이해하여)
  headline String?
  /// 큰 제목 (예: k-DISC 진단 및 교육을 진행합니다)
  title    String
  /// 제목 아래 한 줄 (예: 사전 진단을 반드시 완료해 주세요)
  subtitle String?

  /* 교육 정보 — 교육생이 가장 먼저 확인하는 것들 -------------------------- */

  eventAt     DateTime?
  /// 시간 표기 (예: 09:30~11:30 (2시간))
  eventTime   String?
  /// 교육 장소 (예: 롯데GRS 아카데미 503호)
  venue       String?
  /// 대상 (예: 인재육성팀 전원 (17명))
  audience    String?
  /// 강사 (예: 정하늘 (네오아이즈 전문강사))
  instructor  String?

  /// 진단을 실제로 보는 사이트 주소. 코드와 함께 안내한다.
  targetUrl String?

  /// 유의사항 — 줄바꿈으로 여러 개를 적는다
  notices String?
  /// 문의처 (예: 인재육성팀 정소영 프로 (02-709-1085))
  inquiry String?

  /// 안내 문구 — 진단 방법이나 기한을 적어 둔다
  guide String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)

  /// 동명이인이 있을 때 한 사람을 특정하기 위한 추가 확인 항목
  /// none / phone4(휴대폰 뒤 4자리) / employeeId(사번)
  verifyField String @default("none")

  /// 기간을 벗어나면 조회되지 않는다
  opensAt  DateTime?
  closesAt DateTime?

  isActive Boolean @default(true)

  createdBy String?

  participants ParticipantCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/// 교육생 한 명과 그가 받을 코드
model ParticipantCode {
  id String @id @default(cuid())

  distributionId String
  distribution   CodeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  name String
  code String

  /// 소속·부서 — 동명이인 구분과 안내에 쓴다
  department String?

  /// 추가 확인 값 (휴대폰 뒤 4자리 또는 사번). verifyField 가 none 이면 비워 둔다.
  verifyValue String?

  /// 본인이 코드를 확인했는가 — 아직 안 본 사람만 따로 챙길 수 있다
  viewedAt  DateTime?
  viewCount Int       @default(0)

  createdAt DateTime @default(now())

  @@index([distributionId])
  @@index([name])
}

/// 고객사 프로파일 — 통화·미팅에서 파악해야 할 항목들을 한곳에 모은다.
/// 채워진 항목 수로 "우리가 이 고객사를 얼마나 아는가"(프로파일 완성도)를 계산한다.
model AccountProfile {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /* 조직 구조 ------------------------------------------------------------ */

  /// 내근직 / 현장직 / 혼합 — 교육 방식(집합·온라인·교대조)을 좌우한다
  workforceType String?
  /// 현장직 비율(%) — 혼합일 때 교대 편성 규모 산정에 쓴다
  fieldRatio    Int?

  /// HR 조직 구조 (인재개발원 별도 / 인사팀 내 교육파트 / 전담 없음 ...)
  hrStructure   String?
  /// 교육 담당 인원 수
  hrHeadcount   Int?
  /// 의사결정 구조 (실무자 검토 → 팀장 전결 / 임원 보고 필요 ...)
  decisionProcess String?

  /* 예산 ----------------------------------------------------------------- */

  /// 회계연도 시작 월 (1~12). 공공기관은 대개 1월, 일부 기업은 4월·7월
  fiscalStartMonth Int?
  /// 다음 해 교육 예산을 편성하는 월 (1~12) — 제안 타이밍의 핵심
  budgetMonth      Int?
  /// 예산 확정 주기 (연간 / 반기 / 분기 / 수시)
  budgetCycle      String?
  /// 연간 교육 예산 규모(원)
  budgetScale      Int?
  budgetNote       String?

  /* 시즌 ----------------------------------------------------------------- */

  /// 채용이 몰리는 월 — "3,9" 처럼 콤마로 구분해 저장한다
  hiringMonths   String?
  hiringNote     String?
  /// 교육이 몰리는 월 — "3,4,10,11"
  trainingMonths String?
  /// 시즌별로 어떤 교육을 하는지
  trainingNote   String?

  /* 교육·문화 ------------------------------------------------------------ */

  /// 매년 반복하는 정기 교육 (신입 입문, 승진자 과정, 법정의무 ...)
  regularPrograms   String?
  /// 조직문화 관련 활동 (워크숍, 타운홀, 서베이 ...)
  cultureActivities String?
  /// 기존 거래 교육업체 · 경쟁사
  competitors       String?

  /* 확장 가능성 ---------------------------------------------------------- */

  /// 타 부서 소개·확장 가능성 (높음 / 보통 / 낮음)
  expansionLevel       String?
  /// 확장 가능한 부서 이름
  expansionDepartments String?

  notes String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// 고객사 담당자 (교육 담당자, 인사팀 등)
model Contact {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  department String? // 인재개발원, 인사팀 ...
  position   String? // 과장, 팀장 ...
  email      String?
  phone      String? // 직통
  mobile     String? // 휴대폰

  /// 대표 담당자 여부 — 고객사당 1명을 권장
  isPrimary Boolean @default(false)

  memo String?

  /* ---------------------------------------------------------------------- */
  /*  첫 만남 — 어디서 처음 만났는지                                          */
  /* ---------------------------------------------------------------------- */

  firstMetAt      DateTime?
  /// 만난 경로 (전시회 / 세미나 / 소개 / 인바운드 / 콜드콜 / 입찰설명회 ...)
  firstMetChannel String?
  /// 구체적인 장소·행사명 (예: 2025 HRD 컨퍼런스, 코엑스)
  firstMetPlace   String?
  /// 소개해 준 사람
  referredBy      String?

  /* ---------------------------------------------------------------------- */
  /*  재직 상태와 인수인계                                                    */
  /*  담당자 정보를 여기서 갱신하면 고객사 화면의 "담당자 변경 이력"이          */
  /*  자동으로 만들어진다. 별도 이력 테이블에 다시 입력할 필요가 없다.          */
  /* ---------------------------------------------------------------------- */

  /// 재직 / 휴직 / 퇴사 / 타부서이동 / 타사이직
  status String @default("재직")

  /// 이 사람이 우리 창구가 된 날 / 창구에서 빠진 날
  assignedFrom  DateTime?
  assignedUntil DateTime?

  /// 변경 사유 (인사이동 / 퇴사 / 조직개편 / 업무분장 변경 ...)
  changeReason String?
  /// 인계 내용
  handoverNote String?

  /// 후임 담당자
  successorId String?  @unique
  successor   Contact? @relation("ContactSuccession", fields: [successorId], references: [id], onDelete: SetNull)
  predecessor Contact? @relation("ContactSuccession")

  businessCards BusinessCard[]
  deals         Deal[]
  activities    Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([name])
  @@index([status])
}

/// 명함 이력 — 받은 명함을 시점별로 남긴다.
/// 승진·부서이동·이직으로 직함과 소속이 바뀌는 과정이 그대로 기록된다.
model BusinessCard {
  id String @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// 명함을 받은 날
  receivedAt DateTime

  /// 명함에 적힌 값 — 현재 담당자 정보와 별개로 그 시점의 사실을 보존한다
  companyName String?
  department  String?
  position    String?
  email       String?
  phone       String?
  mobile      String?
  address     String?

  /// 어디서 받았는지 (전시회 / 세미나 / 방문미팅 / 소개 ...)
  receivedChannel String?
  receivedPlace   String?

  /// 명함 이미지 링크 (사내 드라이브 등)
  imageUrl String?

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([receivedAt])
}

/// 자사 교육 과정 마스터
model Course {
  id String @id @default(cuid())

  code String @unique // LDR-001
  name String // 신임팀장 리더십 과정

  category String @default("직무") // 리더십 / 직무 / 법정의무 / DX / CS / 기타
  format   String @default("집합") // 집합 / 온라인 / 블렌디드

  durationHours Float @default(8) // 총 시수
  defaultPrice  Int   @default(0) // 1인당 기본 단가(원)
  minHeadcount  Int? // 최소 개설 인원

  description String?
  isActive    Boolean @default(true)

  trainings Training[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// 교육 진행 이력 — 어느 고객사에 언제 무슨 과정을 몇 명에게 진행했는가
model Training {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  /// 실제 운영 차수명 (예: 2026년 상반기 신임팀장 과정 1차)
  title String

  startDate DateTime
  endDate   DateTime?

  headcount    Int @default(0) // 수료 인원
  pricePerHead Int @default(0) // 1인당 단가(원)
  totalAmount  Int @default(0) // 총 계약금액(원) — 인원×단가와 다를 수 있어 별도 보관

  location   String? // 고객사 연수원 / 자사 강의장 / 온라인
  instructor String? // 담당 강사

  status String @default("예정") // 예정 / 진행중 / 완료 / 취소

  /// 만족도 (5점 만점)
  satisfaction Float?

  memo String?

  distributions CodeDistribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([startDate])
  @@index([status])
}

/// 영업 기회 — 문의부터 계약까지의 파이프라인
model Deal {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title String // 2026 상반기 리더십 교육 제안

  stage String @default("문의") // 문의 / 제안 / 견적 / 계약 / 완료 / 실패

  expectedAmount Int @default(0) // 예상 매출(원)
  probability    Int @default(20) // 성사 확률(%)

  expectedCloseDate DateTime?
  closedAt          DateTime?

  /// 실패 시 사유 (가격 / 경쟁사 / 예산 / 시기 ...)
  lostReason String?

  ownerName String? // 사내 영업 담당자

  memo String?

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([stage])
}

/// 활동 기록 — 전화·메일·미팅 로그와 후속 조치
model Activity {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  type String @default("전화") // 전화 / 이메일 / 미팅 / 방문 / 제안발표 / 기타

  occurredAt DateTime @default(now())

  summary String // 한 줄 요약
  content String? // 상세 내용

  /// 후속 조치 — 대시보드의 "할 일" 목록으로 올라온다
  nextAction     String?
  nextActionDate DateTime?
  isDone         Boolean   @default(false)

  ownerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([occurredAt])
  @@index([nextActionDate])
}

// ---------------------------------------------------------------------------
//  기업 리서치
//
//  AccountProfile 과 성격이 다르다.
//   - AccountProfile : 통화로 알아낸 것 (예산 편성월, HR 구조 ...)
//   - CompanyResearch: 밖에서 조사한 것 (공시, 뉴스, 홈페이지 ...)
//  섞으면 "이 값을 어디서 알았나"가 흐려져 상담 중에 신뢰할 수 없게 된다.
// ---------------------------------------------------------------------------

model CompanyResearch {
  id String @id @default(cuid())

  /// 아직 고객사로 등록되지 않은 회사도 조사할 수 있어야 한다
  companyName String

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// 상담 첫 화면에 뜨는 한 줄
  summary String?

  // 기본
  legalName     String?
  orgType       String?
  industry      String?
  foundedYear   Int?
  ceoName       String?
  address       String?
  website       String?
  phone         String?
  /// 상장 / 코스닥 / 비상장 / 외감 / 공공
  listingStatus String?
  /// 소속 그룹 — 대기업 계열사인지 판단하는 근거
  groupName     String?
  /// DART 고유번호. 자동 조회를 붙일 때 쓴다
  corpCode      String?
  bizRegNo      String?

  // 인력
  employeeTotal     Int?
  employeeRegular   Int?
  employeeIrregular Int?
  /// 평균 근속연수. 퇴직율은 공개되지 않으므로 이 값으로 대신 본다.
  /// 근속이 짧으면 신입 유입이 많다는 뜻이라 신입 과정 제안 근거가 된다.
  avgTenureYears    Float?
  /// 국민연금 가입자수 — 비상장 기업의 사실상 정직원 수
  pensionSubscribers Int?
  pensionAsOf        String?
  /// 최근 3년 인원 증감 서술
  headcountTrend     String?

  // 채용
  hiringMode     String?
  /// 통상 채용 시기 (쉼표로 구분한 월)
  hiringMonths   String?
  hiringScale    String?
  recentPostings String?
  careersUrl     String?

  // HRD · 조직문화
  mission          String?
  vision           String?
  coreValues       String?
  talentProfile    String?
  cultureNote      String?
  trainingPrograms String?
  hrdOrgStructure  String?
  hrdDirection     String?

  // 경영
  revenue            String?
  operatingProfit    String?
  financialsAsOf     String?
  sustainabilityUrl  String?
  sustainabilityNote String?

  // 우리 관점
  salesAngle    String?
  expectedNeeds String?
  cautions      String?

  // 메타
  researchedAt DateTime?
  researchedBy String?
  /// 찾아봤지만 확인되지 않은 항목. 빈칸("아직 안 봄")과 구분하기 위해 따로 남긴다.
  gaps         String?

  sources ResearchSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
}

/// 근거. 출처 없는 값은 상담에서 쓸 수 없으므로 화면에서 항상 같이 보여준다.
model ResearchSource {
  id String @id @default(cuid())

  researchId String
  research   CompanyResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  /// 공시 / 뉴스 / 홈페이지 / 채용 / 보고서 / 기타
  kind        String    @default("기타")
  title       String
  publisher   String?
  url         String?
  publishedAt DateTime?

  createdAt DateTime @default(now())

  @@index([researchId])
}

// ---------------------------------------------------------------------------
//  HRD 트렌드
//
//  국내 기관 사이트의 RSS 주소는 바뀌거나 아예 없는 경우가 많다.
//  그래서 소스를 코드에 박지 않고 화면에서 등록·수정하게 한다.
// ---------------------------------------------------------------------------

model TrendSource {
  id String @id @default(cuid())

  name String
  /// rss   — url 에서 RSS/Atom 을 읽는다
  /// naver — keyword 로 네이버 뉴스 검색 API 를 호출한다
  kind String @default("rss")

  url     String?
  keyword String?

  /// HRD / 채용 / 경제 / AI / 글로벌
  category String @default("HRD")

  isActive Boolean @default(true)

  lastFetchedAt DateTime?
  lastError     String?
  lastItemCount Int?

  items TrendItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model TrendItem {
  id String @id @default(cuid())

  sourceId String
  source   TrendSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title String
  /// 같은 기사를 여러 소스가 물어와도 한 번만 남게 한다
  url   String @unique

  publisher   String?
  publishedAt DateTime?
  summary     String?
  category    String    @default("HRD")

  isPinned Boolean   @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([category])
  @@index([isPinned])
}

/// 주간 브리핑 — 모아둔 기사를 AI 가 요약해 "그래서 어디로 가는가"를 정리한 문서.
/// Claude API 키(.env 의 ANTHROPIC_API_KEY)가 있어야 만들 수 있다.
model TrendBrief {
  id String @id @default(cuid())

  periodStart DateTime
  periodEnd   DateTime

  /// 요약에 쓴 기사 수
  itemCount Int

  /// 브리핑 본문 (마크다운)
  content String

  /// 어떤 모델이 썼는지 — 나중에 품질 비교용
  model String

  createdBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
