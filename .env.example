# 이 파일을 복사해 .env 로 이름을 바꾸고, 아래 두 값을 채우세요.
#   Windows 명령 프롬프트:  copy .env.example .env
#
# .env 는 저장소에 올라가지 않습니다(.gitignore). 비밀번호가 들어 있으니
# 메신저나 메일로 주고받지 마세요.


# ── 1. 데이터베이스 주소 ───────────────────────────────────────────────
# 사무실 PC 에 설치한 PostgreSQL 에 접속하는 주소입니다.
# PostgreSQL 설치할 때 정한 비밀번호를 <비밀번호> 자리에 넣으세요.
#
# 비밀번호에 @ : / ? # 같은 기호가 있으면 접속이 안 될 수 있습니다.
# 영문자와 숫자로만 된 비밀번호를 쓰는 편이 안전합니다.
DATABASE_URL="postgresql://crm:<비밀번호>@localhost:5432/crm"


# ── 2. 세션 서명 키 ────────────────────────────────────────────────────
# 로그인 상태를 위조하지 못하게 막는 열쇠입니다. 32자 이상이어야 합니다.
#
# 만드는 방법 — 명령 프롬프트에 아래를 그대로 붙여넣고 나온 값을 쓰세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 이 값이 바뀌면 전원 로그아웃됩니다. 한 번 정하면 바꾸지 마세요.
AUTH_SECRET=""


# ── 3. (선택) 네이버 뉴스 검색 — HRD 트렌드 자동 수집 ─────────────────
# 없어도 CRM 은 정상 동작합니다. 키워드 소스는 키가 필요 없는 구글 뉴스로 모이고,
# 네이버 키를 넣으면 네이버 뉴스까지 같이 봅니다.
#
# 2026년 6월부터 네이버 검색 API 는 네이버 클라우드 플랫폼의 "NAVER API HUB" 에서
# 발급합니다. (ncloud.com 콘솔 → NAVER API HUB → Application 등록 → 검색 선택
#  → 인증 정보). 계정 만들 때 결제수단 등록이 필요하지만 검색 API 는 무료 구간이
# 넉넉해 이 CRM 사용량으로는 과금되지 않습니다.
NAVER_APIHUB_KEY_ID=""
NAVER_APIHUB_KEY=""
#
# 옛 개발자센터(developers.naver.com) 키를 이미 갖고 있다면 아래에 넣어도 됩니다.
# 2027년 6월 30일까지만 동작합니다.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""


# ── 4. (선택) 트렌드 자동 수집 암호 ───────────────────────────────────
# 작업 스케줄러가 매일 자동으로 기사를 모으게 하려면 필요합니다.
# 아무 긴 무작위 문자열이면 됩니다 (AUTH_SECRET 만드는 방법과 동일).
# collect-trends.bat 이 이 값을 읽어 서버에 전달합니다.
TRENDS_CRON_TOKEN=""


# ── 5. (선택) Claude API — 주간 브리핑 ────────────────────────────────
# console.anthropic.com 에서 발급. 사용한 만큼만 과금됩니다
# (주 1회 브리핑 기준 월 몇천 원 수준).
# 없어도 CRM 은 정상 동작하고, 브리핑 화면에 발급 안내가 뜹니다.
ANTHROPIC_API_KEY=""


# ── 6. (선택) 금감원 DART — 기업 리서치 자동 채우기 ───────────────────
# opendart.fss.or.kr 에서 무료 발급 (인증키 신청/관리 → 즉시 발급).
# 있으면 기업 리서치에서 대표자·주소·설립연도·직원현황을 공시에서 자동으로 채웁니다.
DART_API_KEY=""


# ── 7. (선택) 국민연금 — 비상장·소규모 회사의 직원 규모 ────────────────
# data.go.kr 에서 "국민연금 가입 사업장 내역" 활용신청 (무료, 자동 승인).
# 마이페이지의 일반 인증키(Decoding) 를 넣으세요. Encoding 키를 넣어도 동작합니다.
# DART 에 직원현황이 없는 회사의 가입자 수(≒ 상시 직원 수)를 채웁니다.
NPS_API_KEY=""


# ── 8. (선택) 외부 접속 주소 — Cloudflare Tunnel 등을 쓸 때만 ────────────
# 터널이 주는 주소를 적어야 저장 버튼(서버 액션)이 막히지 않습니다. 쉼표로 여러 개.
# Tailscale 처럼 직접 접속하는 방식은 비워 두면 됩니다.
CRM_EXTERNAL_HOSTS=""
